# ==============================================================
# VANITA MATH CLASSES (VMC) — BACKEND ENVIRONMENT VARIABLES
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/vanita_math_classes
# Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/vanita_math_classes?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vanita_math_classes

# Security & JSON Web Tokens
# Generate a strong 32+ character random string in production
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Initial Administrator Account (for first-time seed / bootstrap)
ADMIN_NAME=Vanita Rani Gupta
ADMIN_EMAIL=admin@vanitamathclasses.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Email Service — Resend API (Preferred for 6-Digit OTP Recovery)
# Sign up free at https://resend.com (100 free emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Vanita Math Classes <onboarding@resend.dev>

# Standard SMTP Fallback (Used if RESEND_API_KEY is not provided)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Meta WhatsApp Cloud API (Graph API v20.0)
# Optional: If omitted, system falls back to direct wa.me link generation at zero cost
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Online Payment Gateway (Razorpay)
# Sign up at https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Cloud File Storage (Cloudinary)
# Optional: If omitted, files are saved locally to backend/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
